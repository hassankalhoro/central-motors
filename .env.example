# Canonical public site URL (used for SEO/OG metadata).
# Set this in Vercel → Project → Settings → Environment Variables.
NEXT_PUBLIC_SITE_URL=https://centralmotors.com.pk

# ------------------------------------------------------------------ #
# Email / SMTP  (form notifications — Contact & Online Inquiry)
# ------------------------------------------------------------------ #
# Titan Email:  host smtp.titan.email, port 465 (SSL) or 587 (STARTTLS)
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=contact@caisol.com
SMTP_PASS=__set_in_.env.local__

# Envelope "From" — must be the authenticated mailbox (or an alias of it).
MAIL_FROM="Suzuki Central Motors <contact@caisol.com>"
# Where form notifications are delivered.
MAIL_TO=mhammad@vectortechsol.com
