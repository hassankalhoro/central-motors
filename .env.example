# Canonical public site URL (used for SEO/OG metadata).
# Set this in Vercel → Project → Settings → Environment Variables.
NEXT_PUBLIC_SITE_URL=https://centralmotors.com.pk

# ------------------------------------------------------------------ #
# Email / SMTP  (form notifications — Contact & Online Inquiry)
# ------------------------------------------------------------------ #
# Titan Email:  host smtp.titan.email, port 465 (SSL) or 587 (STARTTLS)
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=contact@caisol.com
SMTP_PASS=__set_in_.env.local__

# Envelope "From" — must be the authenticated mailbox (or an alias of it).
MAIL_FROM="Suzuki Central Motors <contact@caisol.com>"
# Where form notifications are delivered.
MAIL_TO=mhammad@vectortechsol.com

# ------------------------------------------------------------------ #
# Database — Neon Postgres (lifetime-free tier)
# ------------------------------------------------------------------ #
# DATABASE_URL = POOLED connection (host contains "-pooler") — app runtime.
# DIRECT_URL   = DIRECT connection (no "-pooler")            — prisma migrate.
DATABASE_URL="postgresql://USER:PASSWORD@EP-ID-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@EP-ID.REGION.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------ #
# Cloudinary — image/file storage + optimization (lifetime-free tier)
# ------------------------------------------------------------------ #
# One var holds cloud name + key + secret. Get it from Cloudinary dashboard.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ------------------------------------------------------------------ #
# Admin auth (Dealer Management Portal)
# ------------------------------------------------------------------ #
AUTH_SECRET=__64_hex_chars__   # openssl rand -hex 32 ; signs admin session JWT
ENCRYPTION_KEY=__64_hex_chars__ # openssl rand -hex 32 ; encrypts stored SMTP password
ADMIN_EMAIL=admin@scm.com.pk    # first super-admin, created by `prisma db seed`
ADMIN_PASSWORD=__change_me__    # first super-admin password (change after first login)
